# The public distribution: the builds published on GitHub and at
# https://agent-keepalive.gurupras.me.
#
# A profile is a list of KEY=value lines read by scripts/profile.sh, which
# turns them into -ldflags for internal/distro. To make your own
# organisation's build, copy this file outside the repository (or keep it in
# your own CI), change the URLs and run
#
#   PROFILE=/path/to/org.env make release
#
# Nothing here is a secret. The signing keys that go with UPDATE_PUBLIC_KEY
# and the repository key are CI secrets (see docs/releasing.md).

PROFILE_NAME=public
VENDOR=gurupras
HOMEPAGE=https://agent-keepalive.gurupras.me

# Usage reports (see docs/metrics.md). Empty disables reporting entirely.
METRICS_URL=https://agent-keepalive.gurupras.me/hub
# on: reporting is on until the user turns it off. off: until they turn it on.
METRICS_DEFAULT=on
# true: users cannot change it; only an administrator's config file can.
METRICS_LOCKED=false

# Self-update (AppImage, Windows, macOS, archives). Empty disables updates.
UPDATE_FEED_URL=https://agent-keepalive.gurupras.me/download/latest.json
# Hex Ed25519 public key; the feed must be signed with the matching seed.
UPDATE_PUBLIC_KEY=

DOWNLOAD_URL=https://agent-keepalive.gurupras.me/download
REPO_URL=https://agent-keepalive.gurupras.me/download/repo
