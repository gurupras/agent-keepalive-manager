#!/bin/sh
# AppImage entry point. Running the AppImage is `agent-keepalive open`: start
# the server in the background if none is running and open the UI. Arguments
# pass through, so `./agent-keepalive-….AppImage status` runs `status` and any
# other argument goes to `open`.
#
# The updater recognises the AppImage by $APPIMAGE (set by the runtime) and
# replaces that file, so updating needs no root.
HERE="$(dirname "$(readlink -f "$0")")"
BIN="${HERE}/usr/bin/agent-keepalive"

case "${1:-}" in
  serve|status|open|stop|update|metrics|version|help|-h|--help)
    exec "$BIN" "$@" ;;
esac
exec "$BIN" open "$@"
