# Copy to .env next to docker-compose.yml.
SITE_HOST=agent-keepalive.gurupras.me

# The existing Traefik: its docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# The directory the release workflow uploads to (the DOWNLOAD_ROOT secret).
# Must exist and be writable by the deploy user before the first release.
DOWNLOAD_ROOT=/srv/agent-keepalive/download

# Hub image tag: latest, or a version such as 1.2.0.
HUB_TAG=latest
# public | token | off. With token, set HUB_DASHBOARD_TOKEN.
HUB_DASHBOARD=token
# Required with token: a long random string, e.g. `openssl rand -hex 32`.
HUB_DASHBOARD_TOKEN=
# Leave empty: public builds send reports without a token.
HUB_INGEST_TOKEN=
HUB_RETENTION_DAYS=730
