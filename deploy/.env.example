# Copy to .env next to docker-compose.yml.

# Where release files live on the host (an absolute path; nginx serves it at
# /download/). The upload container writes here as UPLOAD_UID, which should
# own it.
DOWNLOAD_ROOT=/mnt/data/agent-keepalive/download
UPLOAD_UID=1000
# Public port of the upload container's sshd (DOWNLOAD_SSH_PORT in CI).
UPLOAD_PORT=2222

# The hub's port on 127.0.0.1, which the reverse proxy forwards /hub/ to.
HUB_PORT=6720

# Hub image tag: latest, or a version such as 1.2.0.
HUB_TAG=latest
# Postgres password for the hub's database: `openssl rand -hex 24`.
HUB_DB_PASSWORD=
# public | token | off. With token, set HUB_DASHBOARD_TOKEN.
HUB_DASHBOARD=token
# Required with token: a long random string, e.g. `openssl rand -hex 32`.
HUB_DASHBOARD_TOKEN=
# Leave empty: public builds send reports without a token.
HUB_INGEST_TOKEN=
HUB_RETENTION_DAYS=730
